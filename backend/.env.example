# Gemini via Vertex AI + Application Default Credentials (org policy disallows API keys)
# Run `gcloud auth application-default login` locally — no key needed here.
GOOGLE_GENAI_USE_VERTEXAI=True
GOOGLE_CLOUD_PROJECT=cinepulse-504612
GOOGLE_CLOUD_LOCATION=us-central1

# Parallel Search API key — https://platform.parallel.ai
PARALLEL_API_KEY=

# Actor/crew outreach + confirmation emails go through SMTP at
# MAILPIT_HOST:MAILPIT_PORT. For local dev, point this at a local SMTP
# catcher — Mailpit by default (https://mailpit.axllent.org). Install:
#   brew install mailpit && mailpit          # web UI at localhost:8025
# or: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# Leave these at their defaults if running Mailpit locally on default ports.
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
MAIL_FROM=VantageTime <noreply@vantagetime.local>

# For real delivery (e.g. in production), point MAILPIT_HOST/PORT at a
# real SMTP relay instead and set SMTP_USER/SMTP_PASSWORD — e.g. Gmail:
#   MAILPIT_HOST=smtp.gmail.com
#   MAILPIT_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<a Gmail App Password, not your normal password —
#     generate one at https://myaccount.google.com/apppasswords, which
#     requires 2-Step Verification to be turned on>
#   MAIL_FROM=VantageTime <you@gmail.com>
# STARTTLS + login only happen when SMTP_USER is set, so Mailpit (no
# auth, no TLS) keeps working unchanged with the defaults above.
SMTP_USER=
SMTP_PASSWORD=
